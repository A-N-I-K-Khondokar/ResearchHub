# ============================================================
# CSE Research Hub — Firebase Environment Variables
# ============================================================
# 1. Copy this file to .env in the project root:
#       cp .env.example .env
# 2. Fill in every value from your Firebase Console:
#       https://console.firebase.google.com
#       → Project Settings → General → Your apps → Web app
#       → SDK setup and configuration → Config object
# 3. NEVER commit .env — it is listed in .gitignore.
# ============================================================

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=cse-research-hub
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ============================================================
# Optional: Google Sign-In for native development builds (EAS Build / dev client)
# 
# Web Google Sign-In uses Firebase popup and requires only the Firebase keys above.
# Native Android and iOS Google Sign-In use OpenID Connect (ID Token) with Google Cloud Console OAuth Client IDs:
#   - Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
#   - Android: Client ID configured with package name "com.cse.researchhub" + SHA-1 fingerprint
#   - iOS: Client ID configured with bundle identifier "com.cse.researchhub"
#   - Web / Audience: Web Application Client ID
# ============================================================
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=



