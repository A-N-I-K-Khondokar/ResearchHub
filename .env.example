# ============================================================
# CSE Research Hub — Firebase Environment Variables
# ============================================================
# 1. Copy this file to .env in the project root:
#       cp .env.example .env
# 2. Fill in every value from your Firebase Console:
#       https://console.firebase.google.com
#       → Project Settings → General → Your apps → Web app
#       → SDK setup and configuration → Config object
# 3. NEVER commit .env — it is listed in .gitignore.
# ============================================================

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=cse-research-hub
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ============================================================
# Google Sign-In Configuration
#
# WEB:
#   Web Google Sign-In uses Firebase popup (signInWithPopup) and
#   requires only the Firebase configuration keys above.
#
# NATIVE MOBILE (Android & iOS via @react-native-google-signin/google-signin):
#   Requires an Expo development build (EAS Build / local prebuild).
#   1. Google Cloud Console → APIs & Services → Credentials:
#      - Create an OAuth 2.0 Client ID of type "Web Application".
#      - Paste that Web Client ID below into EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID.
#        (This serves as the server audience to generate Firebase ID tokens).
#   2. iOS (if deploying to iOS):
#      - Create an OAuth 2.0 Client ID of type "iOS" with bundle ID "com.cse.researchhub".
#      - Paste into EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID below.
#   3. Android:
#      - Create an OAuth 2.0 Client ID of type "Android" with package "com.cse.researchhub"
#        and your SHA-1 signing fingerprint. (No androidClientId env var needed).
# ============================================================
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=




