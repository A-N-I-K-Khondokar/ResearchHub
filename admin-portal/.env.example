# CSE Research Hub Admin Portal — Environment Configuration Example
# Copy this file to .env.local and fill in the values from your Firebase Project Settings.

# Firebase Web App Configuration (Firebase Console -> Project Settings -> General)
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=cse-research-hub.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cse-research-hub
VITE_FIREBASE_APP_ID=1:...:web:...
VITE_FIREBASE_MESSAGING_SENDER_ID=...

# Authorized Administrator Email (Enforced at Auth Boundary)
VITE_ADMIN_EMAIL=anik.khondokar09@gmail.com

